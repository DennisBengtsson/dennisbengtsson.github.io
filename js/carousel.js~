// Funktion för att hämta och visa RSS-flöde från Byggvärlden
function loadNewsCarousel() {
    // URL till RSS-flödet
    const rssUrl = 'https://www.byggvarlden.se/feed/';
    // Proxy för att kringgån CORS (enklast lösning)
    const proxyUrl = 'https://api.allorigins.win/raw?url=';
    //const proxyUrl = 'https://cors-anywhere.herokuapp.com/'; // Alternativ proxy

    fetch(proxyUrl + encodeURIComponent(rssUrl))
        .then(response => response.text())
        .then(str => new window.DOMParser().parseFromString(str, "text/xml"))
        .then(data => {
            const items = data.querySelectorAll("item");
            const carouselInner = document.getElementById('news-carousel-inner');
            carouselInner.innerHTML = ''; // Töm loading-meddelandet

            // Loopa genom de 5 senaste nyheterna och skapa karusell-items
            items.forEach((item, index) => {
                if (index >= 5) return; // Begränsa till 5 nyheter

                const title = item.querySelector("title").textContent;
                const link = item.querySelector("link").textContent;
                // Försök hämta en bild från mediainnehåll eller description
                let imageUrl = '';
                const mediaContent = item.querySelector("content\\:encoded, encoded");
                if (mediaContent) {
                    const parser = new DOMParser();
                    const htmlDoc = parser.parseFromString(mediaContent.textContent, "text/html");
                    const img = htmlDoc.querySelector("img");
                    if (img) imageUrl = img.src;
                }

                const isActive = index === 0 ? 'active' : '';

                // Skapa HTML för karusell-item
                const carouselItem = `
                    <div class="carousel-item ${isActive}">
                        <div class="container py-5">
                            <div class="row justify-content-center">
                                <div class="col-md-8">
                                    <div class="card shadow">
                                        ${imageUrl ? `<img src="${imageUrl}" class="card-img-top" alt="${title}" style="height: 250px; object-fit: cover;">` : ''}
                                        <div class="card-body">
                                            <h5 class="card-title">${title}</h5>
                                            <a href="${link}" target="_blank" rel="noopener" class="btn btn-primary">Läs mer</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                carouselInner.innerHTML += carouselItem;
            });
        })
        .catch(error => {
            console.error('Error fetching RSS feed:', error);
            document.getElementById('news-carousel-inner').innerHTML = `
                <div class="carousel-item active">
                    <div class="container py-5">
                        <div class="row justify-content-center">
                            <div class="col-md-8 text-center">
                                <p>Kunde inte ladda nyheterna just nu.</p>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        });
}

// Kör funktionen när sidan laddat
$(document).ready(function() {
    loadNewsCarousel();
});
